# ── Anthropic API Configuration ──────────────────────────────────────
# Required: Your Anthropic API key (get one at https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Model to use (default: claude-sonnet-4-20250514)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional: Maximum tokens for responses (default: 4096)
ANTHROPIC_MAX_TOKENS=4096

# Optional: Base URL for the Anthropic API (default: https://api.anthropic.com)
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional: Request timeout in milliseconds (default: 120000)
ANTHROPIC_TIMEOUT_MS=120000

# Optional: Temperature for response generation (default: 0.7, range: 0.0–1.0)
ANTHROPIC_TEMPERATURE=0.7
